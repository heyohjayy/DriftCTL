# Values used by the safe real-collection command; do not commit credentials.
DRIFTCTL_AWS_PROFILE=driftctl-readonly
DRIFTCTL_AWS_REGION=us-east-1
# Optional: role trusted by the selected profile. The caller also needs sts:AssumeRole.
DRIFTCTL_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/driftctl-readonly
